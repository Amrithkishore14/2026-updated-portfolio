---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import experience from '../data/experience.json';
import education from '../data/education.json';
import certifications from '../data/certifications.json';
import awards from '../data/awards.json';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const engineering = all.filter((p) => !p.data.featured && p.data.category !== 'design');
const design = all.filter((p) => p.data.category === 'design');
const cloudCerts = certifications.items.filter((c) => c.group === 'cloud');
const otherCerts = certifications.items.filter((c) => c.group !== 'cloud');
const catLabel = { cloud: 'Cloud & security', web: 'Web & client work', fullstack: 'Full-stack', design: 'Design' };
const lanes = [
  { ...site.roles[0], href: '#work' },
  { ...site.roles[1], href: '#design' },
  { ...site.roles[2], href: '#process' },
];
const steps = [
  { t: 'Audit', d: 'Find out what is really wrong before proposing anything.' },
  { t: 'Propose', d: 'Write it down with diagrams and costs, then re-scope to the budget.' },
  { t: 'Build in phases', d: 'Short cycles with screen-by-screen reviews, not one big reveal.' },
  { t: 'Launch', d: 'Plan the cutover, test it, and be there when it goes live.' },
  { t: 'Hand over', d: 'Leave the client in control: their accounts, their repo, a CMS they can use.' },
];
---
<Base>
  <!-- HERO -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-top">
      <p class="hero-name">{site.fullName} · {site.location}</p>
      <h1 id="hero-title" class="hero-title">
        <span class="line"><span>I keep cloud systems running,</span></span>
        <span class="line"><span>and design the screens</span></span>
        <span class="line"><span>people use them through.</span></span>
      </h1>
    </div>
    <div class="hero-copy">
      <p class="lead">{site.intro}</p>
      <div class="hero-ctas">
        <a class="btn btn-signal" href="#work">See my work</a>
        <a class="btn btn-line" href={site.cv} download>Download CV</a>
      </div>
    </div>

    <aside class="board" aria-label="Current status">
      <div class="board-top">
        <span class="board-host">status · amrith</span>
        <span class="board-ok"><i aria-hidden="true"></i>All systems operational</span>
      </div>
      <dl class="board-list">
        <div><dt>role</dt><dd>{site.currentRole}</dd></div>
        <div><dt>based</dt><dd>{site.location} · <span data-clock>--:--</span> local</dd></div>
        <div><dt>open to</dt><dd>{site.openTo}</dd></div>
        <div><dt>certified</dt><dd>AWS SAA · AWS CCP · AZ-900 · AI-900 · OCI</dd></div>
        <div><dt>shipping</dt><dd>since Jan 2023 · <span data-uptime></span></dd></div>
        <div><dt>response</dt><dd>usually within a day</dd></div>
      </dl>
      <a class="board-cta" href={`mailto:${site.email}`}>{site.email}</a>
    </aside>
  </section>

  <!-- LANES -->
  <section class="wrap lanes" aria-label="What I bring">
    {lanes.map((l) => (
      <a class="lane" href={l.href}>
        <h2>{l.title}</h2>
        <ul>{l.points.map((p) => <li>{p}</li>)}</ul>
        <span class="lane-go">See the evidence</span>
      </a>
    ))}
  </section>

  <!-- WORK -->
  <section id="work" class="section wrap" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title" class="section-title">Work I can walk you through in detail</h2>
      <p>Each one has a case study: the problem, what I did, and what happened. Two of them are live right now.</p>
    </div>
    <div class="cases">
      {featured.map((p, i) => (
        <article class={`case ${i % 2 ? 'flip' : ''}`}>
          <a class="case-media" href={`/work/${p.id}`} tabindex="-1" aria-hidden="true">
            {p.data.cover
              ? <img src={p.data.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
              : <div class="case-type"><span>{p.data.title.split(' ')[0]}</span><small>{p.data.stack.slice(0, 3).join(' · ')}</small></div>}
          </a>
          <div class="case-body">
            <p class="case-meta">{catLabel[p.data.category]} · {p.data.year}</p>
            <h3><a href={`/work/${p.id}`}>{p.data.title}</a></h3>
            <p class="case-sum">{p.data.summary}</p>
            {p.data.outcomes.length > 0 && <ul class="outcomes">{p.data.outcomes.map((o) => <li>{o}</li>)}</ul>}
            <div class="case-links">
              <a class="btn btn-ink btn-sm" href={`/work/${p.id}`}>Read the case study</a>
              {p.data.live && <a class="btn btn-line btn-sm" href={p.data.live} target="_blank" rel="noopener">{p.data.liveLabel}</a>}
              {!p.data.live && p.data.code && <a class="btn btn-line btn-sm" href={p.data.code} target="_blank" rel="noopener">View the code</a>}
            </div>
          </div>
        </article>
      ))}
    </div>

    <h3 class="sub-title">More engineering</h3>
    <ul class="mini-list">
      {engineering.map((p) => (
        <li>
          <a href={`/work/${p.id}`}>
            <span class="mini-title">{p.data.title}</span>
            <span class="mini-sum">{p.data.summary}</span>
            <span class="mini-stack">{p.data.stack.slice(0, 4).join(' · ')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- DESIGN -->
  <section id="design" class="design" aria-labelledby="design-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="design-title" class="section-title">Design work, from fashion to fintech</h2>
        <p>Every site below opens live. Concepts made with AI assistance are labelled as concepts.</p>
      </div>
      <div class="gallery">
        {design.map((p, i) => (
          <a class="tile" href={`/work/${p.id}`}>
            <div class="tile-img"><img src={p.data.cover} alt={`${p.data.title} homepage`} loading="lazy" /></div>
            <div class="tile-cap">
              <span class="tile-title">{p.data.title}</span>
              <span class="tile-role">{p.data.role}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" class="section wrap" aria-labelledby="process-title">
    <div class="section-head">
      <h2 id="process-title" class="section-title">How I run a project</h2>
      <p>The same five stages took Elmar Risk Management from a Wix audit to a live site its owner now updates himself.</p>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step"><span class="step-n">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></li>
      ))}
    </ol>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="section wrap exp" aria-labelledby="exp-title">
    <div class="exp-head">
      <h2 id="exp-title" class="section-title">Experience</h2>
      <p class="lead">Cloud, web and client work, alongside jobs that taught me to lead a team on a busy Friday night.</p>
      <div class="edu">
        <h3>Education</h3>
        {education.items.map((e) => (
          <div class="edu-item"><p class="edu-deg">{e.degree}</p><p class="edu-org">{e.org} · {e.start} – {e.end}</p></div>
        ))}
      </div>
    </div>
    <ol class="timeline">
      {experience.items.map((x) => (
        <li class="job">
          <p class="job-when">{x.start}{x.end !== x.start ? ` – ${x.end}` : ''}</p>
          <div>
            <h3>{x.role}</h3>
            <p class="job-org">{x.org} · {x.place}</p>
            <ul>{x.points.map((pt) => <li>{pt}</li>)}</ul>
            {x.link && <a class="job-link" href={x.link}>Read the case study</a>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- CREDENTIALS -->
  <section id="credentials" class="section creds" aria-labelledby="cred-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="cred-title" class="section-title">Certifications and recognition</h2>
        <p>Certified across four cloud providers, and recognised by my university for Azure AI.</p>
      </div>
      <div class="cred-grid">
        <div>
          <h3 class="cred-h">Cloud certifications</h3>
          <ul class="cert-list">
            {cloudCerts.map((c) => <li><span class="cert-name">{c.name}</span><span class="cert-meta">{c.issuer}{c.code ? ` · ${c.code}` : ''}</span></li>)}
          </ul>
          <h3 class="cred-h">Other certificates</h3>
          <ul class="cert-list small">
            {otherCerts.map((c) => <li><span class="cert-name">{c.name}</span><span class="cert-meta">{c.issuer}</span></li>)}
          </ul>
        </div>
        <div class="awards">
          {awards.items.map((a) => (
            <article class="award"><p class="award-year">{a.year}</p><h3>{a.title}</h3><p class="award-by">{a.by}</p><p>{a.detail}</p></article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="wrap contact-in">
      <h2 id="contact-title">Hiring for 2027? Let's talk.</h2>
      <p class="contact-sub">{site.openTo}. Based in {site.location}, happy to work hybrid.</p>
      <a class="contact-mail" href={`mailto:${site.email}`}>{site.email}</a>
      <div class="contact-links">
        <a class="btn btn-signal" href={site.cv} download>Download CV</a>
        <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener">GitHub</a>
        <a class="btn btn-ghost" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const clock = document.querySelector('[data-clock]');
  const tick = () => { if (clock) clock.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' }).format(new Date()); };
  tick(); setInterval(tick, 30000);
  const up = document.querySelector('[data-uptime]');
  if (up) {
    const start = new Date('2023-01-01');
    const months = Math.floor((Date.now() - start.getTime()) / (30.44 * 864e5));
    up.textContent = `${Math.floor(months / 12)} yrs ${months % 12} mo`;
  }
</script>

<style>
  /* HERO */
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 28px 64px; align-items: start; padding-top: 72px; padding-bottom: 80px; }
  .hero-top { grid-column: 1 / -1; }
  .hero-name { font-weight: 600; color: var(--graphite); margin-bottom: 22px; }
  .hero-title { font-size: clamp(30px, 4.6vw, 70px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; }
  .hero-title .line { display: block; overflow: hidden; padding-bottom: .05em; }
  .hero-title .line > span { display: inline-block; animation: rise .9s cubic-bezier(.2,.7,.1,1) both; }
  .hero-title .line:nth-child(2) > span { animation-delay: .1s; color: var(--signal); }
  .hero-title .line:nth-child(3) > span { animation-delay: .2s; color: var(--signal); }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  .hero .lead { margin: 18px 0 34px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  .board { background: var(--panel); color: var(--panel-text); border-radius: 22px; padding: 26px; font-family: var(--mono); font-size: 14px; box-shadow: 0 40px 80px -40px rgba(19,23,31,.55); }
  .board-top { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 18px; border-bottom: 1px solid #2B3240; margin-bottom: 8px; flex-wrap: wrap; }
  .board-host { color: var(--panel-muted); }
  .board-ok { display: inline-flex; align-items: center; gap: 8px; color: #6EE7A0; }
  .board-ok i { width: 9px; height: 9px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 rgba(24,169,87,.6); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(24,169,87,.55); } 70% { box-shadow: 0 0 0 10px rgba(24,169,87,0); } 100% { box-shadow: 0 0 0 0 rgba(24,169,87,0); } }
  .board-list > div { display: grid; grid-template-columns: 96px 1fr; gap: 14px; padding: 12px 0; border-bottom: 1px dashed #2B3240; opacity: 0; animation: boot .35s ease-out forwards; }
  .board-list > div:nth-child(1) { animation-delay: .5s; } .board-list > div:nth-child(2) { animation-delay: .65s; } .board-list > div:nth-child(3) { animation-delay: .8s; }
  .board-list > div:nth-child(4) { animation-delay: .95s; } .board-list > div:nth-child(5) { animation-delay: 1.1s; } .board-list > div:nth-child(6) { animation-delay: 1.25s; }
  @keyframes boot { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
  .board dt { color: var(--panel-muted); }
  .board dd { color: #fff; }
  .board-cta { display: block; margin-top: 18px; color: #FFB394; text-decoration: none; word-break: break-all; }
  .board-cta:hover { text-decoration: underline; }

  /* LANES */
  .lanes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); }
  .lane { display: flex; flex-direction: column; padding: 30px 28px 26px; text-decoration: none; border-right: 1px solid var(--line); transition: background .2s; }
  .lane:last-child { border-right: 0; }
  .lane:hover { background: #fff; }
  .lane h2 { font-size: 22px; margin-bottom: 14px; }
  .lane ul { list-style: none; color: var(--graphite); flex: 1; }
  .lane li { padding: 6px 0 6px 18px; position: relative; }
  .lane li::before { content: ""; position: absolute; left: 0; top: 15px; width: 8px; height: 2px; background: var(--signal); }
  .lane-go { margin-top: 18px; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--signal); }

  /* CASES */
  .cases { display: flex; flex-direction: column; gap: 96px; }
  .case { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; align-items: center; }
  .case.flip .case-media { order: 2; }
  .case-media { display: block; border-radius: var(--radius); overflow: hidden; background: var(--paper-2); aspect-ratio: 16 / 10; border: 1px solid var(--line); }
  .case-media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .6s cubic-bezier(.2,.7,.1,1); }
  .case-media:hover img { transform: scale(1.03); }
  .case-type { height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 36px; background: var(--ink); color: #fff; }
  .case-type span { font-family: var(--display); font-weight: 700; font-size: clamp(40px, 6vw, 84px); letter-spacing: -0.04em; line-height: .95; color: var(--signal); }
  .case-type small { font-family: var(--mono); color: var(--panel-muted); font-size: 14px; }
  .case-meta { color: var(--muted); font-weight: 500; margin-bottom: 10px; }
  .case h3 { font-size: clamp(24px, 2.4vw, 34px); margin-bottom: 14px; }
  .case h3 a { text-decoration: none; }
  .case h3 a:hover { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 6px; }
  .case-sum { color: var(--graphite); font-size: 18px; }
  .outcomes { list-style: none; margin: 22px 0 26px; border-top: 1px solid var(--line); }
  .outcomes li { padding: 11px 0 11px 28px; border-bottom: 1px solid var(--line); position: relative; font-weight: 500; }
  .outcomes li::before { content: "✓"; position: absolute; left: 2px; color: var(--ok); font-weight: 700; }
  .case-links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }

  .sub-title { font-size: 22px; margin: 110px 0 18px; }
  .mini-list { list-style: none; border-top: 1.5px solid var(--ink); }
  .mini-list a { display: grid; grid-template-columns: 1.1fr 1.6fr 1fr; gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; align-items: baseline; }
  .mini-list a:hover .mini-title { color: var(--signal-ink); }
  .mini-title { font-family: var(--display); font-weight: 600; font-size: 17px; }
  .mini-sum { color: var(--graphite); }
  .mini-stack { color: var(--muted); font-size: 14px; text-align: right; }

  /* DESIGN */
  .design { background: var(--ink); color: #fff; padding: 120px 0; }
  .design .section-head p { color: var(--panel-muted); }
  .gallery { display: grid; grid-template-columns: repeat(6, 1fr); gap: 28px 22px; }
  .tile { grid-column: span 2; }
  .tile:nth-child(-n+2), .tile:nth-child(n+6) { grid-column: span 3; }
  .tile { text-decoration: none; display: flex; flex-direction: column; gap: 14px; }
  .tile-img { border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 10; background: var(--panel-2); }
  .tile-img img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .6s cubic-bezier(.2,.7,.1,1); }
  .tile:hover img { transform: scale(1.04); }
  .tile-cap { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .tile-title { font-weight: 600; }
  .tile:hover .tile-title { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 5px; }
  .tile-role { color: var(--panel-muted); font-size: 14px; text-align: right; }

  /* PROCESS */
  .steps { list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; position: relative; }
  .step { padding: 0 22px 0 0; position: relative; }
  .step::before { content: ""; position: absolute; top: 22px; left: 52px; right: 8px; height: 2px; background: var(--line); }
  .step:last-child::before { display: none; }
  .step-n { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--ink); font-family: var(--mono); font-weight: 600; font-size: 14px; background: var(--paper); position: relative; z-index: 1; }
  .step h3 { font-size: 18px; margin: 20px 0 8px; }
  .step p { color: var(--graphite); font-size: 16px; }

  /* EXPERIENCE */
  .exp { display: grid; grid-template-columns: 1fr 1.6fr; gap: 72px; align-items: start; }
  .exp-head { position: sticky; top: 104px; }
  .exp-head .lead { margin: 18px 0 32px; font-size: 18px; }
  .edu h3 { font-size: 16px; margin-bottom: 10px; }
  .edu-item { padding: 12px 0; border-top: 1px solid var(--line); }
  .edu-deg { font-weight: 600; }
  .edu-org { color: var(--muted); font-size: 15px; }
  .timeline { list-style: none; border-top: 1.5px solid var(--ink); }
  .job { display: grid; grid-template-columns: 150px 1fr; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .job-when { font-family: var(--mono); font-size: 14px; color: var(--muted); padding-top: 4px; }
  .job h3 { font-size: 19px; }
  .job-org { color: var(--graphite); font-weight: 500; margin: 4px 0 10px; }
  .job ul { padding-left: 18px; color: var(--graphite); }
  .job li { margin: 4px 0; }
  .job-link { display: inline-block; margin-top: 10px; font-weight: 600; text-decoration-color: var(--signal); text-underline-offset: 5px; }

  /* CREDENTIALS */
  .creds { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .cred-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .cred-h { font-size: 16px; margin: 0 0 12px; }
  .cert-list { list-style: none; border-top: 1.5px solid var(--ink); margin-bottom: 40px; }
  .cert-list li { display: flex; justify-content: space-between; gap: 18px; padding: 15px 0; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .cert-name { font-weight: 600; }
  .cert-meta { color: var(--muted); font-size: 15px; }
  .cert-list.small .cert-name { font-weight: 500; }
  .awards { display: grid; gap: 16px; align-content: start; }
  .award { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; background: var(--paper); }
  .award:first-child { background: var(--ink); color: #fff; border-color: var(--ink); }
  .award:first-child .award-by, .award:first-child p:last-child { color: var(--panel-muted); }
  .award-year { font-family: var(--mono); font-size: 13px; color: var(--signal); }
  .award h3 { font-size: 19px; margin: 8px 0 4px; }
  .award-by { font-weight: 500; color: var(--graphite); margin-bottom: 8px; }
  .award p:last-child { color: var(--graphite); }

  /* CONTACT */
  .contact { background: var(--signal); color: var(--ink); padding: 120px 0; }
  .contact h2 { font-size: clamp(36px, 5.4vw, 80px); letter-spacing: -0.04em; max-width: 16ch; }
  .contact-sub { font-size: 20px; margin: 20px 0 30px; max-width: 46ch; }
  .contact-mail { display: inline-block; font-family: var(--display); font-weight: 600; font-size: clamp(20px, 3vw, 40px); color: var(--ink); text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 8px; margin-bottom: 36px; word-break: break-all; }
  .contact-links { display: flex; gap: 10px; flex-wrap: wrap; }
  .contact .btn-signal { background: var(--ink); border-color: var(--ink); }
  .btn-ghost { border-color: var(--ink); }
  .btn-ghost:hover { background: var(--ink); color: #fff; }

  @media (max-width: 1000px) {
    .hero, .case, .exp, .cred-grid { grid-template-columns: 1fr; }
    .hero-title .line > span { display: inline; }
    .case.flip .case-media { order: 0; }
    .exp-head { position: static; }
    .lanes { grid-template-columns: 1fr; }
    .lane { border-right: 0; border-bottom: 1px solid var(--line); }
    .gallery { grid-template-columns: 1fr 1fr; }
    .tile, .tile:nth-child(-n+2), .tile:nth-child(n+6) { grid-column: auto; }
    .steps { grid-template-columns: 1fr; gap: 26px; }
    .step::before { display: none; }
    .mini-list a { grid-template-columns: 1fr; gap: 6px; }
    .mini-stack { text-align: left; }
  }
  @media (max-width: 620px) {
    .hero { padding-top: 40px; gap: 40px; }
    .gallery { grid-template-columns: 1fr; }
