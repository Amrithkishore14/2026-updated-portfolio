---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap" style="padding:120px 32px 160px">
    <h1 style="font-size:clamp(36px,6vw,80px)">That page isn't here.</h1>
    <p class="lead" style="margin:20px 0 30px">It may have moved when the portfolio was rebuilt.</p>
    <a class="btn btn-ink" href="/">Go to the homepage</a>
  </section>
</Base>
